# Names only. All secret/private values stay outside Git.
APP_BASE_URL=https://replies.jamesbugden.com
# Verify the actual guide/tool origin independently before setting this.
RESOURCE_BASE_URL=
APP_TIMEZONE=Asia/Taipei

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, restricted administrative worker only. Never ordinary user routes.
SUPABASE_SECRET_KEY=
# Direct Postgres connection. Used ONLY by scripts/ (the importer and the embedding
# worker), which have no browser session to run under. Never read by the app.
SUPABASE_DB_URL=

AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Private external paths; no actual paths/owner emails/IDs in this template.
PRIVATE_SOURCE_ROOT=
PRIVATE_EVAL_SET_PATH=
# Comma-separated author IDs the import adapters treat as the owner. Without it
# every authored row goes to review, which is honest but unusable. Private values.
PRIVATE_OWNER_AUTHOR_IDS=
